PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/football-booking
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
BOOKING_HOLD_MINUTES=10

# Configure this API Key in the SePay webhook security settings.
SEPAY_WEBHOOK_API_KEY=replace-with-the-sepay-api-key
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=

# SMTP settings used by password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:4200
